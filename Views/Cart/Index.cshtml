@model List<AspNetMvcApp.Models.CartItemViewModel>
@{
    ViewData["Title"] = "Giỏ Hàng - Viễn Thông Gia Trí";
    decimal subtotal = Model.Sum(item => item.TotalPrice);
}

<style>
    /* ═══ PREMIUM CART STYLES ═══ */
    .cart-page-container {
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-xl);
        padding: 2.5rem;
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        box-shadow: var(--shadow-card);
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
    }

    .cart-page-glow {
        position: absolute;
        width: 350px;
        height: 350px;
        top: -150px;
        left: -150px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(0, 180, 255, 0.06) 0%, transparent 65%);
        pointer-events: none;
    }

    .cart-header-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 1.8rem;
        color: var(--text-primary);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        border-bottom: 1px solid var(--border-light);
        padding-bottom: 1rem;
    }

    .cart-header-title i {
        background: var(--grad-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .cart-layout-grid {
        display: grid;
        grid-template-columns: 2.2fr 1fr;
        gap: 2rem;
        align-items: start;
    }

    @@media (max-width: 992px) {
        .cart-layout-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ── Cart Items List ── */
    .cart-items-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .cart-item-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(13, 33, 55, 0.25);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        transition: var(--transition-normal);
        position: relative;
        gap: 1rem;
    }

    body.theme-light .cart-item-card {
        background: rgba(255, 255, 255, 0.85);
    }

    .cart-item-card:hover {
        border-color: rgba(0, 180, 255, 0.2);
        background: rgba(0, 180, 255, 0.02);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .cart-item-left {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex: 1.5;
    }

    .cart-item-img-box {
        width: 80px;
        height: 80px;
        background: rgba(13, 33, 55, 0.3);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem;
        flex-shrink: 0;
    }

    body.theme-light .cart-item-img-box {
        background: rgba(0, 0, 0, 0.02);
    }

    .cart-item-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 4px 8px rgba(0,0,0,0.15));
    }

    .cart-item-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .cart-item-name {
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
        line-height: 1.4;
    }

    .cart-item-price {
        font-size: 0.82rem;
        color: var(--text-secondary);
        font-weight: 500;
    }

    .cart-item-center {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        gap: 1.5rem;
    }

    .cart-qty-control {
        display: flex;
        align-items: center;
        border: 1px solid var(--border-light);
        border-radius: 6px;
        overflow: hidden;
        background: rgba(13, 33, 55, 0.2);
    }

    body.theme-light .cart-qty-control {
        background: rgba(0, 0, 0, 0.02);
    }

    .cart-qty-btn {
        width: 28px;
        height: 28px;
        border: none;
        background: transparent;
        color: var(--text-primary);
        font-size: 0.85rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease;
    }

    .cart-qty-btn:hover {
        background: rgba(0, 180, 255, 0.08);
    }

    .cart-qty-input {
        width: 36px;
        height: 28px;
        border: none;
        border-left: 1px solid var(--border-light);
        border-right: 1px solid var(--border-light);
        background: transparent;
        color: var(--text-primary);
        text-align: center;
        font-size: 0.85rem;
        font-weight: 600;
        outline: none;
        -moz-appearance: textfield;
    }

    .cart-qty-input::-webkit-outer-spin-button,
    .cart-qty-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .cart-item-total-box {
        text-align: right;
        min-width: 110px;
    }

    .cart-item-total-label {
        font-size: 0.65rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .cart-item-total-price {
        font-family: 'Outfit', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .cart-item-delete {
        background: rgba(239, 68, 68, 0.06);
        border: 1px solid rgba(239, 68, 68, 0.15);
        color: #ef4444;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: var(--transition-fast);
        font-size: 0.85rem;
    }

    .cart-item-delete:hover {
        background: #ef4444;
        color: #ffffff;
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
    }

    /* ── Cart Summary Sidebar ── */
    .cart-summary-card {
        background: rgba(13, 33, 55, 0.3);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        position: sticky;
        top: 90px;
    }

    body.theme-light .cart-summary-card {
        background: rgba(255, 255, 255, 0.95);
    }

    .summary-title {
        font-family: 'Outfit', sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-primary);
        border-bottom: 1px solid var(--border-light);
        padding-bottom: 0.75rem;
        margin: 0;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.88rem;
        color: var(--text-secondary);
    }

    .summary-row.total-row {
        border-top: 1px solid var(--border-light);
        padding-top: 1rem;
        margin-top: 0.5rem;
    }

    .summary-total-label {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .summary-total-value {
        font-family: 'Outfit', sans-serif;
        font-size: 1.3rem;
        font-weight: 800;
        color: #00b4ff;
    }

    .btn-checkout-custom {
        background: linear-gradient(135deg, #0076f7, #00b4ff);
        border: none;
        color: #ffffff;
        padding: 0.85rem 1.5rem;
        font-size: 0.95rem;
        font-weight: 700;
        border-radius: var(--radius-md);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: var(--transition-normal);
        box-shadow: 0 4px 18px rgba(0, 118, 247, 0.3);
        font-family: 'Outfit', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        text-decoration: none !important;
        width: 100%;
        margin-top: 0.5rem;
    }

    .btn-checkout-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 118, 247, 0.45);
        filter: brightness(1.05);
    }

    .btn-continue-shopping {
        background: transparent;
        border: 1px solid var(--border-light);
        color: var(--text-secondary);
        padding: 0.65rem 1.25rem;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: var(--radius-md);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        transition: var(--transition-fast);
        text-decoration: none !important;
        width: 100%;
    }

    .btn-continue-shopping:hover {
        border-color: rgba(0, 180, 255, 0.2);
        color: var(--text-primary);
        background: rgba(0, 180, 255, 0.04);
    }

    /* ── Empty State ── */
    .cart-empty-showroom {
        text-align: center;
        padding: 4rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .cart-empty-icon {
        font-size: 4rem;
        background: var(--grad-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 1.5rem;
        filter: drop-shadow(0 8px 16px rgba(0, 118, 247, 0.15));
    }

    .cart-empty-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
    }

    .cart-empty-desc {
        color: var(--text-secondary);
        max-width: 420px;
        font-size: 0.88rem;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    /* ── Checkbox custom styling ── */
    .cart-select-all-wrapper {
        background: rgba(13, 33, 55, 0.25);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-sm);
        padding: 0.75rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    body.theme-light .cart-select-all-wrapper {
        background: rgba(255, 255, 255, 0.85);
    }

    .cart-item-checkbox-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-right: 0.5rem;
    }

    .cart-item-checkbox {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #00b4ff;
        border-radius: 4px;
        border: 1px solid var(--border-light);
        transition: var(--transition-fast);
    }

    .cart-item-checkbox:hover {
        transform: scale(1.1);
    }
</style>

<div class="cart-page-container">
    <div class="cart-page-glow"></div>

    <h1 class="cart-header-title">
        <i class="fa-solid fa-cart-shopping"></i> Giỏ Hàng Của Bạn
    </h1>

    <div id="cartContentArea">
        @if (Model == null || !Model.Any())
        {
            <div class="cart-empty-showroom">
                <i class="fa-solid fa-bag-shopping cart-empty-icon"></i>
                <h3 class="cart-empty-title">Giỏ hàng trống</h3>
                <p class="cart-empty-desc">
                    Bạn chưa thêm thiết bị nào vào giỏ hàng. Hãy tham khảo và lựa chọn sản phẩm mạng & camera giám sát chính hãng của chúng tôi.
                </p>
                <a href="@Url.Action("Index", "Products")" class="btn-primary-custom" style="padding: 0.75rem 2rem; text-decoration: none;">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại Cửa hàng
                </a>
            </div>
        }
        else
        {
            <div class="cart-layout-grid">
                <!-- Left: List of products -->
                <div class="cart-items-wrapper">
                    <div class="cart-select-all-wrapper">
                        <input type="checkbox" id="selectAllCheckbox" checked onchange="toggleSelectAll(this)" class="cart-item-checkbox" />
                        <label for="selectAllCheckbox" style="font-size: 0.88rem; color: var(--text-secondary); cursor: pointer; font-weight: 600; margin: 0; user-select: none;">
                            Chọn tất cả sản phẩm (@Model.Count)
                        </label>
                    </div>

                    @foreach (var item in Model)
                    {
                        <div class="cart-item-card" id="cart-item-@item.ProductId">
                            <!-- Checkbox for item selection -->
                            <div class="cart-item-checkbox-wrapper">
                                <input type="checkbox" class="cart-item-checkbox item-checkbox" data-product-id="@item.ProductId" checked onchange="updateSummary()" />
                            </div>

                            <div class="cart-item-left">
                                <div class="cart-item-img-box">
                                    <img src="~/product/imges/@item.ImagePath" alt="@item.Name" class="cart-item-img" />
                                </div>
                                <div class="cart-item-info">
                                    <h3 class="cart-item-name">@item.Name</h3>
                                    <span class="cart-item-price">Đơn giá: @((item.Price * 25000).ToString("#,##0")) đ</span>
                                </div>
                            </div>

                            <div class="cart-item-center">
                                <!-- Qty Selector -->
                                <div class="cart-qty-control">
                                    <button class="cart-qty-btn" type="button" onclick="updateCartQty(@item.ProductId, -1)">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>
                                    <input type="number" class="cart-qty-input" id="qty-input-@item.ProductId" value="@item.Quantity" min="1" onchange="onQtyInputChange(@item.ProductId)" onkeypress="return event.charCode >= 48 && event.charCode <= 57" style="-moz-appearance: textfield;" />
                                    <button class="cart-qty-btn" type="button" onclick="updateCartQty(@item.ProductId, 1)">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>

                                <!-- Total Item Price -->
                                <div class="cart-item-total-box">
                                    <div class="cart-item-total-label">Thành tiền</div>
                                    <div class="cart-item-total-price" id="item-total-@item.ProductId">
                                        @((item.TotalPrice * 25000).ToString("#,##0")) đ
                                    </div>
                                </div>

                                <!-- Delete button -->
                                <button class="cart-item-delete" type="button" onclick="removeCartItem(@item.ProductId)" title="Xóa sản phẩm">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Actions Row -->
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <a href="@Url.Action("Index", "Products")" class="btn-secondary-custom">
                            <i class="fa-solid fa-arrow-left"></i> Tiếp tục mua hàng
                        </a>
                        <button class="btn-secondary-custom text-danger border-danger-subtle" onclick="clearWholeCart()">
                            <i class="fa-solid fa-trash-can"></i> Xóa toàn bộ giỏ hàng
                        </button>
                    </div>
                </div>

                <!-- Right: Summary and Checkout -->
                <div class="cart-summary-card">
                    <h3 class="summary-title">Thông tin đơn hàng</h3>
                    
                    <div class="summary-row">
                        <span>Tạm tính:</span>
                        <span id="summarySubtotal">@((subtotal * 25000).ToString("#,##0")) đ</span>
                    </div>
                    
                    <div class="summary-row">
                        <span>Phí vận chuyển:</span>
                        <span class="text-success fw-600">Miễn phí</span>
                    </div>

                    <div class="summary-row total-row">
                        <span class="summary-total-label">Tổng thanh toán:</span>
                        <span class="summary-total-value" id="summaryTotal">@((subtotal * 25000).ToString("#,##0")) đ</span>
                    </div>

                    <button type="button" class="btn-checkout-custom" onclick="proceedToCheckout()">
                        Tiến Hành Thanh Toán <i class="fa-solid fa-chevron-right"></i>
                    </button>
                    
                    <a href="@Url.Action("Index", "Products")" class="btn-continue-shopping mt-2">
                        Tìm thêm sản phẩm khác
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            updateSummary();
        });

        // Toggle Select All checkboxes
        function toggleSelectAll(selectAllBox) {
            const checkboxes = document.querySelectorAll('.item-checkbox');
            checkboxes.forEach(box => {
                box.checked = selectAllBox.checked;
            });
            updateSummary();
        }

        // Calculate and update the summary of checked items
        function updateSummary() {
            let subtotal = 0;
            const checkedBoxes = document.querySelectorAll('.item-checkbox:checked');
            
            checkedBoxes.forEach(box => {
                const productId = box.getAttribute('data-product-id');
                const totalEl = document.getElementById(`item-total-${productId}`);
                if (totalEl) {
                    const text = totalEl.innerText.replace(/[^0-9]/g, '');
                    const price = parseFloat(text) || 0;
                    subtotal += price;
                }
            });

            // Update DOM element values
            const formatted = subtotal.toLocaleString('vi-VN') + ' đ';
            const subtotalEl = document.getElementById('summarySubtotal');
            const totalEl = document.getElementById('summaryTotal');
            if (subtotalEl) subtotalEl.innerHTML = formatted;
            if (totalEl) totalEl.innerHTML = formatted;

            // Sync select all checkbox status
            const totalBoxes = document.querySelectorAll('.item-checkbox').length;
            const selectAllBox = document.getElementById('selectAllCheckbox');
            if (selectAllBox) {
                selectAllBox.checked = (totalBoxes === checkedBoxes.length && totalBoxes > 0);
            }

            // Sync Select All count text
            const labelEl = document.querySelector('label[for="selectAllCheckbox"]');
            if (labelEl) {
                labelEl.innerHTML = `Chọn tất cả sản phẩm (${totalBoxes})`;
            }

            // Control checkout button state
            const checkoutBtn = document.querySelector('.btn-checkout-custom');
            if (checkoutBtn) {
                if (checkedBoxes.length === 0) {
                    checkoutBtn.disabled = true;
                    checkoutBtn.style.opacity = '0.5';
                    checkoutBtn.style.cursor = 'not-allowed';
                } else {
                    checkoutBtn.disabled = false;
                    checkoutBtn.style.opacity = '1';
                    checkoutBtn.style.cursor = 'pointer';
                }
            }
        }

        // Update item quantity directly via AJAX
        function setCartQty(productId, newQty) {
            const qtyInput = document.getElementById(`qty-input-${productId}`);
            if (!qtyInput) return;

            if (newQty < 1) {
                removeCartItem(productId);
                return;
            }

            $.ajax({
                url: '/api/cart',
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ productId: productId, quantity: newQty }),
                success: function (res) {
                    if (res.success) {
                        // Update UI values
                        qtyInput.value = res.newQuantity;
                        
                        // Update item total price
                        const itemTotal = document.getElementById(`item-total-${productId}`);
                        if (itemTotal) {
                            itemTotal.innerHTML = res.itemTotalVnd + ' đ';
                        }

                        // Update summary subtotal & total dynamically based on checkboxes
                        updateSummary();

                        // Update header cart badge count
                        updateHeaderBadge(res.totalCount);
                    } else {
                        showNotification(res.message, 'error');
                    }
                },
                error: function (xhr) {
                    let errorMsg = 'Đã có lỗi xảy ra khi cập nhật số lượng.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showNotification(errorMsg, 'error');
                }
            });
        }

        // Update item quantity via AJAX (delta buttons)
        function updateCartQty(productId, delta) {
            const qtyInput = document.getElementById(`qty-input-${productId}`);
            if (!qtyInput) return;

            let currentQty = parseInt(qtyInput.value) || 1;
            let newQty = currentQty + delta;

            setCartQty(productId, newQty);
        }

        // Handle manual quantity input changes
        function onQtyInputChange(productId) {
            const qtyInput = document.getElementById(`qty-input-${productId}`);
            if (!qtyInput) return;

            let val = parseInt(qtyInput.value);
            if (isNaN(val) || val < 1) {
                val = 1;
                qtyInput.value = 1;
            }

            setCartQty(productId, val);
        }

        // Remove item from cart via AJAX
        function removeCartItem(productId) {
            if (!confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?')) {
                return;
            }

            const itemCard = document.getElementById(`cart-item-${productId}`);

            $.ajax({
                url: `/api/cart/${productId}`,
                type: 'DELETE',
                success: function (res) {
                    if (res.success) {
                        if (itemCard) {
                            // Fade out animation before removing
                            itemCard.style.transition = 'all 0.3s ease';
                            itemCard.style.opacity = '0';
                            itemCard.style.transform = 'translateY(15px)';
                            
                            setTimeout(() => {
                                itemCard.remove();
                                
                                // Check if there are items left
                                const remainingCards = document.querySelectorAll('.cart-item-card');
                                if (remainingCards.length === 0) {
                                    renderEmptyCart();
                                } else {
                                    // Update select all text & summary
                                    updateSummary();
                                }
                            }, 300);
                        }

                        // Update badge
                        updateHeaderBadge(res.totalCount);
                        showNotification('Đã xóa sản phẩm khỏi giỏ hàng thành công.', 'info');
                    }
                },
                error: function (xhr) {
                    let errorMsg = 'Không thể xóa sản phẩm.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showNotification(errorMsg, 'error');
                }
            });
        }

        // Clear whole cart via AJAX
        function clearWholeCart() {
            if (!confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng?')) {
                return;
            }

            $.ajax({
                url: '/api/cart',
                type: 'DELETE',
                success: function (res) {
                    if (res.success) {
                        renderEmptyCart();
                        updateHeaderBadge(0);
                        showNotification('Đã làm trống giỏ hàng thành công.', 'info');
                    }
                },
                error: function (xhr) {
                    let errorMsg = 'Không thể làm sạch giỏ hàng.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showNotification(errorMsg, 'error');
                }
            });
        }

        // Render Empty State dynamically
        function renderEmptyCart() {
            const container = document.getElementById('cartContentArea');
            if (container) {
                container.innerHTML = `
                    <div class="cart-empty-showroom">
                        <i class="fa-solid fa-bag-shopping cart-empty-icon"></i>
                        <h3 class="cart-empty-title">Giỏ hàng trống</h3>
                        <p class="cart-empty-desc">
                            Bạn chưa thêm thiết bị nào vào giỏ hàng. Hãy tham khảo và lựa chọn sản phẩm mạng & camera giám sát chính hãng của chúng tôi.
                        </p>
                        <a href="/Products" class="btn-primary-custom" style="padding: 0.75rem 2rem; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> Quay lại Cửa hàng
                        </a>
                    </div>
                `;
            }
        }

        // Update header badge
        function updateHeaderBadge(count) {
            const badge = document.getElementById('cartBadgeCount');
            if (badge) {
                badge.innerHTML = count;
                // Add micro-animation
                badge.style.transform = 'scale(1.25)';
                setTimeout(() => {
                    badge.style.transform = 'scale(1)';
                }, 200);
            }
        }

        function proceedToCheckout() {
            const checkedBoxes = document.querySelectorAll('.item-checkbox:checked');
            if (checkedBoxes.length === 0) {
                showNotification('Vui lòng chọn ít nhất một sản phẩm để thanh toán.', 'error');
                return;
            }
            const selectedProductIds = Array.from(checkedBoxes).map(box => box.getAttribute('data-product-id')).join(',');
            window.location.href = `/Cart/Checkout?selectedProductIds=${selectedProductIds}`;
        }
    </script>
}
