@{
    ViewData["Title"] = "Viễn Thông Gia Trí";
}

<style>
    /* ═══ HERO BANNER ═══ */
    .hero-banner {
        background: linear-gradient(160deg, #071525 0%, #0d2137 40%, #163656 70%, #0076f7 100%);
        border-radius: var(--radius-xl);
        padding: 3rem 3rem 2.5rem;
        margin-bottom: 2.5rem;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(0, 180, 255, 0.08);
    }

    .hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(0, 180, 255, 0.15) 0%, transparent 65%);
        pointer-events: none;
    }

    .hero-banner::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: 20%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(0, 118, 247, 0.1) 0%, transparent 65%);
        pointer-events: none;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
    }

    .hero-text {
        flex: 1;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(0, 180, 255, 0.12);
        border: 1px solid rgba(0, 180, 255, 0.2);
        color: #4dcfff;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.35rem 0.9rem;
        border-radius: 50px;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .hero-title {
        font-size: 2.4rem;
        font-weight: 800;
        color: #ffffff;
        font-family: 'Outfit', sans-serif;
        line-height: 1.15;
        margin-bottom: 0.75rem;
    }

    .hero-title .accent {
        background: linear-gradient(135deg, #00b4ff, #4dcfff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        color: #8ba3c1;
        font-size: 1rem;
        line-height: 1.6;
        max-width: 520px;
    }

    .hero-stats {
        display: flex;
        gap: 2rem;
        margin-top: 1.5rem;
    }

    .hero-stat {
        text-align: center;
    }

    .hero-stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: #ffffff;
        font-family: 'Outfit', sans-serif;
    }

    .hero-stat-label {
        font-size: 0.72rem;
        color: #8ba3c1;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.15rem;
    }

    @@media (max-width: 768px) {
        .hero-banner { padding: 2rem 1.5rem; }
        .hero-content { flex-direction: column; text-align: center; }
        .hero-title { font-size: 1.8rem; }
        .hero-stats { justify-content: center; }
    }

    /* ═══ FILTER SECTION ═══ */
    .filter-section {
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-xl);
        padding: 1.25rem 1.5rem;
        margin-bottom: 2rem;
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        box-shadow: var(--shadow-card);
    }

    .filter-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 1rem;
        align-items: center;
    }

    @@media (max-width: 768px) {
        .filter-grid { grid-template-columns: 1fr; }
    }

    .filter-input-group {
        position: relative;
        display: flex;
        align-items: center;
    }

    .filter-search-icon {
        position: absolute;
        left: 1rem;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .filter-search-input {
        background: rgba(0, 180, 255, 0.03);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-md);
        padding: 0.68rem 1rem 0.68rem 2.6rem;
        color: var(--text-primary);
        font-size: 0.88rem;
        width: 100%;
        outline: none;
        transition: var(--transition-normal);
    }

    body.theme-light .filter-search-input {
        background: rgba(13, 33, 55, 0.03);
    }

    .filter-search-input:focus {
        background: rgba(0, 180, 255, 0.06);
        border-color: rgba(0, 180, 255, 0.3);
        box-shadow: 0 0 16px rgba(0, 180, 255, 0.08);
    }

    .filter-select-custom {
        background: rgba(0, 180, 255, 0.03);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-md);
        padding: 0.68rem 1rem;
        color: var(--text-primary);
        font-size: 0.88rem;
        outline: none;
        cursor: pointer;
        width: 100%;
        transition: var(--transition-normal);
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg fill='%238ba3c1' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/></svg>");
        background-repeat: no-repeat;
        background-position: right 10px center;
        background-size: 16px;
    }

    body.theme-light .filter-select-custom {
        background-color: rgba(13, 33, 55, 0.03);
    }

    .filter-select-custom:focus {
        border-color: rgba(0, 180, 255, 0.3);
        box-shadow: 0 0 16px rgba(0, 180, 255, 0.08);
    }

    .filter-select-custom option {
        background: #0d2137;
        color: #f0f6fc;
    }

    body.theme-light .filter-select-custom option {
        background: #ffffff;
        color: #0d2137;
    }

    /* ── Category Pills ── */
    .category-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-light);
    }

    .category-pill {
        background: rgba(0, 180, 255, 0.04);
        border: 1px solid var(--border-light);
        color: var(--text-secondary);
        padding: 0.4rem 1.1rem;
        border-radius: var(--radius-pill);
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        transition: var(--transition-fast);
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .category-pill:hover {
        background: rgba(0, 180, 255, 0.08);
        color: var(--text-primary);
        border-color: rgba(0, 180, 255, 0.15);
    }

    .category-pill.active {
        background: linear-gradient(135deg, rgba(0, 118, 247, 0.15), rgba(0, 180, 255, 0.1));
        color: #00b4ff;
        border-color: rgba(0, 180, 255, 0.3);
        box-shadow: 0 0 14px rgba(0, 180, 255, 0.12);
        font-weight: 600;
    }

    /* ═══ PRODUCT GRID ═══ */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    @@media (max-width: 480px) {
        .product-grid { grid-template-columns: 1fr; }
    }

    /* ═══ PRODUCT CARDS ═══ */
    .product-card {
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: var(--transition-normal);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
    }

    .product-card:hover {
        background: var(--bg-dark-card-hover);
        transform: translateY(-6px);
        border-color: rgba(0, 180, 255, 0.2);
        box-shadow: 0 16px 40px -12px rgba(0, 118, 247, 0.15);
    }

    /* Image Container */
    .product-image-container {
        position: relative;
        height: 220px;
        background: linear-gradient(145deg, rgba(13, 33, 55, 0.3) 0%, rgba(7, 21, 37, 0.5) 100%);
        border-bottom: 1px solid var(--border-light);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 1.5rem;
    }

    body.theme-light .product-image-container {
        background: linear-gradient(145deg, rgba(232, 244, 253, 0.5) 0%, rgba(240, 247, 255, 0.3) 100%);
    }

    .product-image {
        max-width: 82%;
        max-height: 82%;
        object-fit: contain;
        transition: var(--transition-normal);
        filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.2));
    }

    .product-card:hover .product-image {
        transform: scale(1.06);
        filter: drop-shadow(0 12px 24px rgba(0, 118, 247, 0.2));
    }

    /* Floating Badges */
    .badge-container-top {
        position: absolute;
        top: 0.85rem;
        left: 0.85rem;
        right: 0.85rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 5;
    }

    .product-badge-cat {
        background: rgba(13, 33, 55, 0.85);
        backdrop-filter: var(--glass-blur);
        border: 1px solid rgba(0, 180, 255, 0.1);
        color: #e8f4fd;
        font-size: 0.68rem;
        font-weight: 600;
        padding: 0.28rem 0.65rem;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    body.theme-light .product-badge-cat {
        background: rgba(255, 255, 255, 0.9);
        color: #0d2137;
        border-color: rgba(13, 33, 55, 0.08);
    }

    .product-badge-stock {
        font-size: 0.68rem;
        font-weight: 600;
        padding: 0.28rem 0.65rem;
        border-radius: 6px;
        backdrop-filter: var(--glass-blur);
        display: inline-flex;
        align-items: center;
    }

    /* Stock Dot animation */
    .tech-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 5px;
        position: relative;
    }

    .tech-dot::after {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 50%;
        border: 1px solid currentColor;
        animation: techPulse 2s infinite ease-in-out;
        opacity: 0.7;
    }

    .dot-green { background: #10b981; color: #10b981; }
    .dot-orange { background: #f59e0b; color: #f59e0b; }
    .dot-red { background: #ef4444; color: #ef4444; }

    @@keyframes techPulse {
        0% { transform: scale(1); opacity: 0.7; }
        50% { transform: scale(2.2); opacity: 0; }
        100% { transform: scale(1); opacity: 0; }
    }

    .stock-instock {
        background: rgba(16, 185, 129, 0.08);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .stock-lowstock {
        background: rgba(245, 158, 11, 0.08);
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.2);
    }

    .stock-outofstock {
        background: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    /* Card Body */
    .product-details {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex: 1;
        justify-content: space-between;
    }

    .product-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.5rem;
        margin-bottom: 0.4rem;
    }

    .product-name {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text-primary);
        font-family: 'Outfit', sans-serif;
        margin: 0;
        line-height: 1.3;
    }

    .product-rating {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background: rgba(255, 215, 0, 0.06);
        border: 1px solid rgba(255, 215, 0, 0.12);
        padding: 0.18rem 0.45rem;
        border-radius: 5px;
        font-size: 0.72rem;
        font-weight: 600;
        color: #fbbf24;
        flex-shrink: 0;
    }

    .product-desc {
        color: var(--text-secondary);
        font-size: 0.82rem;
        line-height: 1.5;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.45rem;
    }

    .product-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--border-light);
        padding-top: 1rem;
        margin-top: auto;
    }

    .product-price-box {
        display: flex;
        flex-direction: column;
    }

    .price-label {
        font-size: 0.68rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .product-price {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text-primary);
        font-family: 'Outfit', sans-serif;
    }

    .product-btn-cart {
        background: linear-gradient(135deg, #0076f7, #00b4ff);
        border: none;
        color: #ffffff;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition-fast);
        cursor: pointer;
        text-decoration: none;
        font-size: 0.85rem;
        box-shadow: 0 3px 12px rgba(0, 118, 247, 0.25);
    }

    .product-btn-cart:hover {
        transform: scale(1.1) translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 118, 247, 0.35);
    }

    /* ═══ PAGINATION ═══ */
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.4rem;
        margin-top: 1rem;
        padding: 0.75rem 1.25rem;
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-pill);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
        box-shadow: var(--shadow-card);
    }

    .page-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-light);
        background: transparent;
        color: var(--text-secondary);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition-fast);
        text-decoration: none !important;
    }

    .page-btn:hover:not(.disabled) {
        background: rgba(0, 180, 255, 0.08);
        color: var(--text-primary);
        border-color: rgba(0, 180, 255, 0.15);
    }

    .page-btn.active {
        background: linear-gradient(135deg, #0076f7, #00b4ff);
        color: #ffffff;
        border-color: transparent;
        box-shadow: 0 0 14px rgba(0, 118, 247, 0.3);
    }

    .page-btn.disabled {
        opacity: 0.3;
        cursor: not-allowed;
        pointer-events: none;
    }

    .page-arrow {
        padding: 0 0.8rem;
        border-radius: var(--radius-pill);
        width: auto;
        gap: 0.3rem;
    }

    /* ═══ EMPTY STATE ═══ */
    .empty-showroom {
        text-align: center;
        padding: 4rem 2rem;
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-xl);
        backdrop-filter: var(--glass-blur);
    }

    .empty-icon {
        font-size: 3.5rem;
        background: linear-gradient(135deg, #0076f7, #00b4ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 1.25rem;
    }
</style>

<!-- ═══ HERO BANNER ═══ -->
<div class="hero-banner">
    <div class="hero-content">
        <div class="hero-text">
            <div class="hero-badge">
                <i class="fa-solid fa-signal"></i> Giải pháp mạng chuyên nghiệp
            </div>
            <h1 class="hero-title">
                <span class="accent">Viễn Thông Gia Trí</span>
            </h1>
            <p class="hero-subtitle">
                Cung cấp thiết bị Camera giám sát, Switch, Router & phụ kiện mạng chính hãng — uy tín, chất lượng hàng đầu TP.HCM.
            </p>
            <div class="hero-stats">
                <div class="hero-stat">
                    <div class="hero-stat-value">500+</div>
                    <div class="hero-stat-label">Sản phẩm</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-value">100%</div>
                    <div class="hero-stat-label">Chính hãng</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-value">24/7</div>
                    <div class="hero-stat-label">Hỗ trợ</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ FILTER & CONTROLS ═══ -->
<div class="filter-section">
    <form method="get" action="@Url.Action("Index", "Products")" id="filterForm">
        <input type="hidden" name="category" value="@Model.SelectedCategory" id="categoryInput" />
        
        <div class="filter-grid">
            <!-- Search -->
            <div class="filter-input-group">
                <i class="fa-solid fa-magnifying-glass filter-search-icon"></i>
                <input type="text" name="searchTerm" id="searchInput" value="@Model.SearchTerm" placeholder="Tìm kiếm thiết bị..." class="filter-search-input" autocomplete="off" />
            </div>

            <!-- Sort -->
            <div>
                <select name="sortBy" class="filter-select-custom">
                    <option value="name_asc" selected="@(Model.SelectedSort == "name_asc" ? "selected" : null)">Tên (A → Z)</option>
                    <option value="name_desc" selected="@(Model.SelectedSort == "name_desc" ? "selected" : null)">Tên (Z → A)</option>
                    <option value="price_asc" selected="@(Model.SelectedSort == "price_asc" ? "selected" : null)">Giá: Thấp → Cao</option>
                    <option value="price_desc" selected="@(Model.SelectedSort == "price_desc" ? "selected" : null)">Giá: Cao → Thấp</option>
                    <option value="rating_desc" selected="@(Model.SelectedSort == "rating_desc" ? "selected" : null)">Đánh giá cao nhất</option>
                </select>
            </div>

            <!-- Reset -->
            <div>
                <a href="@Url.Action("Index", "Products")" class="btn-secondary-custom justify-content-center" style="width: 100%; border-radius: var(--radius-md); padding: 0.65rem 1rem;">
                    <i class="fa-solid fa-arrow-rotate-left"></i> Đặt lại
                </a>
            </div>
        </div>
    </form>

    <!-- Category Pills -->
    <div class="category-pills">
        @{
            var categories = new[] { "All", "Camera Giám Sát", "Thiết Bị Switch", "Thiết Bị Mạng và Phụ Kiện" };
            var categoryIcons = new Dictionary<string, string> {
                { "All", "fa-border-all" },
                { "Camera Giám Sát", "fa-video" },
                { "Thiết Bị Switch", "fa-network-wired" },
                { "Thiết Bị Mạng và Phụ Kiện", "fa-wifi" }
            };
            var categoryLabels = new Dictionary<string, string> {
                { "All", "Tất cả" },
                { "Camera Giám Sát", "Camera" },
                { "Thiết Bị Switch", "Switch" },
                { "Thiết Bị Mạng và Phụ Kiện", "Mạng & Phụ kiện" }
            };
        }
 
        @foreach (var cat in categories)
        {
            var isActive = Model.SelectedCategory == cat;
            <a href="@Url.Action("Index", "Products", new { category = cat, searchTerm = Model.SearchTerm, sortBy = Model.SelectedSort, page = 1 })" 
               class="category-pill @(isActive ? "active" : "")">
                <i class="fa-solid @categoryIcons[cat]"></i>
                @categoryLabels[cat]
            </a>
        }
    </div>
</div>

<!-- ═══ PRODUCT GRID ═══ -->
<div id="productResults">
@if (Model.Products.Count == 0)
{
    <div class="empty-showroom">
        <i class="fa-solid fa-box-open empty-icon"></i>
        <h3 style="font-size: 1.3rem; color: var(--text-primary); margin-bottom: 0.5rem;">Không tìm thấy sản phẩm</h3>
        <p style="color: var(--text-secondary); max-width: 400px; margin: 0 auto 1.5rem auto; font-size: 0.88rem;">
            Không có thiết bị nào khớp với bộ lọc. Vui lòng thử lại với tiêu chí khác.
        </p>
        <a href="@Url.Action("Index", "Products")" class="btn-primary-custom d-inline-flex" style="margin: 0 auto; text-decoration: none;">
            <i class="fa-solid fa-arrow-left"></i> Xem tất cả
        </a>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var product in Model.Products)
        {
            <div class="product-card">
                <!-- Badges -->
                <div class="badge-container-top">
                    <span class="product-badge-cat">@(product.Category?.Name ?? "Sản phẩm")</span>
                    
                    @if (product.StockStatus == "InStock")
                    {
                        <span class="product-badge-stock stock-instock"><span class="tech-dot dot-green"></span>Còn hàng</span>
                    }
                    else if (product.StockStatus == "LowStock")
                    {
                        <span class="product-badge-stock stock-lowstock"><span class="tech-dot dot-orange"></span>Sắp hết</span>
                    }
                    else
                    {
                        <span class="product-badge-stock stock-outofstock"><span class="tech-dot dot-red"></span>Hết hàng</span>
                    }
                </div>

                <!-- Image -->
                <a href="@Url.Action("Details", "Products", new { id = product.Id })" style="text-decoration: none; display: block;">
                    <div class="product-image-container">
                        <img src="~/product/imges/@product.ImagePath" alt="@product.Name" class="product-image" asp-append-version="true" />
                    </div>
                </a>

                <!-- Info -->
                <div class="product-details">
                    <div>
                        <div class="product-title-row">
                            <h3 class="product-name">
                                <a href="@Url.Action("Details", "Products", new { id = product.Id })" style="color: inherit; text-decoration: none; transition: var(--transition-fast);" onmouseover="this.style.color='#00b4ff'" onmouseout="this.style.color='inherit'">
                                    @product.Name
                                </a>
                            </h3>
                            <div class="product-rating">
                                <i class="fa-solid fa-star"></i>
                                <span>@product.Rating.ToString("0.0")</span>
                            </div>
                        </div>
                        <p class="product-desc">@product.Description</p>
                    </div>

                    <div class="product-footer">
                        <div class="product-price-box">
                            <span class="price-label">Giá bán</span>
                            <span class="product-price">@((product.Price * 25000).ToString("#,##0")) đ</span>
                        </div>
                        @if (product.StockStatus == "OutOfStock")
                        {
                            <button class="product-btn-cart bg-secondary" style="cursor: not-allowed; box-shadow: none; opacity: 0.5;" title="Hết hàng" disabled>
                                <i class="fa-solid fa-ban"></i>
                            </button>
                        }
                        else
                        {
                            <button class="product-btn-cart" onclick="addToCartAjax(@product.Id, 1)" title="Thêm vào giỏ hàng">
                                <i class="fa-solid fa-cart-shopping"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    if (Model.TotalPages > 1)
    {
        <div class="pagination-container d-flex justify-content-center">
            <div class="pagination-wrapper">
                <a href="@Url.Action("Index", "Products", new { page = Model.CurrentPage - 1, searchTerm = Model.SearchTerm, category = Model.SelectedCategory, sortBy = Model.SelectedSort })" 
                   class="page-btn page-arrow @(Model.CurrentPage == 1 ? "disabled" : "")" title="Trước">
                    <i class="fa-solid fa-chevron-left"></i> Trước
                </a>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a href="@Url.Action("Index", "Products", new { page = i, searchTerm = Model.SearchTerm, category = Model.SelectedCategory, sortBy = Model.SelectedSort })" 
                       class="page-btn @(Model.CurrentPage == i ? "active" : "")">
                        @i
                    </a>
                }

                <a href="@Url.Action("Index", "Products", new { page = Model.CurrentPage + 1, searchTerm = Model.SearchTerm, category = Model.SelectedCategory, sortBy = Model.SelectedSort })" 
                   class="page-btn page-arrow @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")" title="Sau">
                    Sau <i class="fa-solid fa-chevron-right"></i>
                </a>
            </div>
        </div>
    }
}
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let typingTimer;
            const doneTypingInterval = 400; // ms
            const $searchInput = $('#searchInput');
            const $filterForm = $('#filterForm');
            const $productResults = $('#productResults');

            function fetchResults() {
                const url = $filterForm.attr('action');
                const data = $filterForm.serialize();
                
                // Add visual loading feedback
                $productResults.css('opacity', '0.5');
                
                // Fetch new page content using AJAX
                $.get(url, data, function (responseHtml) {
                    try {
                        // Use DOMParser for safer full-document HTML parsing
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(responseHtml, "text/html");
                        const newContentElement = doc.getElementById('productResults');
                        
                        if (newContentElement) {
                            $productResults.html(newContentElement.innerHTML);
                        }
                    } catch (e) {
                        console.error("Lỗi khi cập nhật giao diện:", e);
                    } finally {
                        $productResults.css('opacity', '1');
                        
                        // Update URL without page reload
                        const newUrl = url + '?' + data;
                        window.history.pushState({path: newUrl}, '', newUrl);
                    }
                }).fail(function() {
                    $productResults.css('opacity', '1');
                    console.error("Lỗi khi tải dữ liệu từ máy chủ");
                });
            }

            // Real-time search when user types
            $searchInput.on('input', function () {
                clearTimeout(typingTimer);
                typingTimer = setTimeout(fetchResults, doneTypingInterval);
            });

            // Real-time sort when user selects
            $('select[name="sortBy"]').on('change', function (e) {
                e.preventDefault();
                fetchResults();
            });

            // Prevent default form submission to avoid full page reload on Enter
            $filterForm.on('submit', function (e) {
                e.preventDefault();
                clearTimeout(typingTimer);
                fetchResults();
            });
        });
    </script>
}
