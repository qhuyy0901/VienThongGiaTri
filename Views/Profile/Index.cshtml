@model AspNetMvcApp.Models.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-4">Hồ sơ cá nhân</h3>

                    @if (TempData["StatusMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["StatusMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-muted">Email (Tài khoản)</label>
                            <input asp-for="Email" class="form-control bg-light" disabled />
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold">Họ và tên</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger text-sm"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger text-sm"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="ChangePassword" class="text-decoration-none">Đổi mật khẩu?</a>
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">Cập nhật hồ sơ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
