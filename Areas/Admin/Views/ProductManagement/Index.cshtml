@model List<AspNetMvcApp.Models.Product>
@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<style>
    .pm-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.75rem;
    }

    .pm-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .pm-header p {
        color: var(--text-secondary);
        font-size: 0.88rem;
        margin: 0.2rem 0 0;
    }

    .pm-btn-add {
        background: var(--grad-primary);
        border: none;
        color: #fff;
        padding: 0.7rem 1.25rem;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        border-radius: 12px;
        cursor: pointer;
        transition: var(--transition-fast);
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .pm-btn-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
        color: #fff;
    }

    .pm-table-card {
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: 16px;
        overflow: hidden;
        backdrop-filter: var(--glass-blur);
    }

    .pm-table {
        width: 100%;
        border-collapse: collapse;
    }

    .pm-table th {
        padding: 1rem 1.25rem;
        color: var(--text-muted);
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-light);
        text-align: left;
    }

    .pm-table td {
        padding: 0.9rem 1.25rem;
        border-bottom: 1px solid var(--border-light);
        font-size: 0.9rem;
        color: var(--text-primary);
        vertical-align: middle;
    }

    .pm-table tr:last-child td {
        border-bottom: none;
    }

    .pm-table tr:hover td {
        background: rgba(255, 255, 255, 0.02);
    }

    .pm-product-cell {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .pm-product-thumb {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        object-fit: contain;
        background: rgba(0, 0, 0, 0.2);
        padding: 4px;
        border: 1px solid var(--border-light);
    }

    .pm-product-name {
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
    }

    .pm-badge {
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .pm-badge-instock {
        background: rgba(16, 185, 129, 0.1);
        color: var(--accent-emerald);
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .pm-badge-lowstock {
        background: rgba(249, 115, 22, 0.1);
        color: var(--accent-orange);
        border: 1px solid rgba(249, 115, 22, 0.2);
    }

    .pm-badge-outofstock {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .pm-actions {
        display: flex;
        gap: 0.5rem;
    }

    .pm-btn-edit {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.2);
        color: var(--accent-blue);
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: var(--transition-fast);
        text-decoration: none;
        font-size: 0.85rem;
    }

    .pm-btn-edit:hover {
        background: rgba(59, 130, 246, 0.2);
        color: var(--accent-blue);
    }

    .pm-btn-delete {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #ef4444;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: var(--transition-fast);
        font-size: 0.85rem;
    }

    .pm-btn-delete:hover {
        background: rgba(239, 68, 68, 0.2);
    }

    .pm-empty {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--text-secondary);
    }

    .pm-empty i {
        font-size: 3rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
    }

    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1.5rem;
        padding: 0 0.5rem;
    }

    .pagination-info {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .pagination-list {
        display: flex;
        gap: 0.35rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .page-item-custom {
        display: inline-flex;
    }

    .page-link-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 36px;
        padding: 0 6px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-light);
        color: var(--text-secondary);
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        font-family: 'Outfit', sans-serif;
    }

    .page-link-custom:hover:not(.disabled) {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text-primary);
        border-color: rgba(255, 255, 255, 0.15);
        transform: translateY(-1px);
    }

    .page-item-custom.active .page-link-custom {
        background: var(--grad-primary);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 4px 10px rgba(59, 130, 246, 0.25);
    }

    .page-link-custom.disabled {
        opacity: 0.35;
        cursor: not-allowed;
        pointer-events: none;
    }
</style>

<div class="pm-header">
    <div>
        <h1>Quản Lý Sản Phẩm</h1>
        <p>Tổng cộng @ViewBag.TotalProducts sản phẩm trong hệ thống</p>
    </div>
    <a asp-action="Create" class="pm-btn-add">
        <i class="fa-solid fa-plus"></i> Thêm Sản Phẩm
    </a>
</div>

<!-- Search Bar -->
<form method="get" class="mb-4 d-flex gap-2">
    <div style="position: relative; display: flex; align-items: center; flex: 1; max-width: 380px;">
        <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 1rem; color: var(--text-muted); font-size: 0.88rem; pointer-events: none;"></i>
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Tìm kiếm theo tên hoặc danh mục..." style="padding: 0.65rem 1rem 0.65rem 2.5rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-light); border-radius: 10px; color: var(--text-primary); outline: none; width: 100%; transition: all 0.2s;" onfocus="this.style.borderColor='rgba(59, 130, 246, 0.5)';" onblur="this.style.borderColor='var(--border-light)';" />
    </div>
    <button type="submit" class="btn-submit py-2" style="background: var(--grad-primary); border: none; color: #fff; padding: 0 1.25rem; font-weight: 600; border-radius: 10px; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.25);">
        <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
    </button>
    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
    {
        <a href="@Url.Action("Index")" class="btn-cancel py-2" style="background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-light); color: var(--text-primary); padding: 0.65rem 1.25rem; font-weight: 600; border-radius: 10px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-arrow-rotate-left"></i> Đặt lại
        </a>
    }
</form>

<div class="pm-table-card">
    @if (Model.Count == 0)
    {
        <div class="pm-empty">
            <i class="fa-solid fa-box-open d-block"></i>
            <h3>Chưa có sản phẩm nào</h3>
            <p>Hãy thêm sản phẩm đầu tiên cho cửa hàng.</p>
        </div>
    }
    else
    {
        <table class="pm-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Sản Phẩm</th>
                    <th>Danh Mục</th>
                    <th>Giá</th>
                    <th>Đánh Giá</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td style="color: var(--text-muted); font-weight: 600;">#@product.Id</td>
                        <td>
                            <div class="pm-product-cell">
                                <img src="~/product/imges/@product.ImagePath" alt="@product.Name" class="pm-product-thumb" />
                                <span class="pm-product-name">@product.Name</span>
                            </div>
                        </td>
                        <td>@(product.Category?.Name ?? "—")</td>
                        <td style="font-weight: 600;">@((product.Price * 25000).ToString("#,##0")) đ</td>
                        <td>
                            <i class="fa-solid fa-star" style="color: #ffd700; font-size: 0.8rem;"></i>
                            @product.Rating.ToString("0.0")
                        </td>
                        <td>
                            @if (product.StockStatus == "InStock")
                            {
                                <span class="pm-badge pm-badge-instock">Còn hàng</span>
                            }
                            else if (product.StockStatus == "LowStock")
                            {
                                <span class="pm-badge pm-badge-lowstock">Sắp hết</span>
                            }
                            else
                            {
                                <span class="pm-badge pm-badge-outofstock">Hết hàng</span>
                            }
                        </td>
                        <td>
                            <div class="pm-actions">
                                <a asp-action="Edit" asp-route-id="@product.Id" class="pm-btn-edit" title="Sửa">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" style="margin:0;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                    <button type="submit" class="pm-btn-delete" title="Xóa">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (ViewBag.TotalPages > 1)
{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;

    <div class="pagination-container">
        <div class="pagination-info">
            Hiển thị từ @(((currentPage - 1) * (int)ViewBag.PageSize) + 1) đến @Math.Min(currentPage * (int)ViewBag.PageSize, (int)ViewBag.TotalProducts) trong số @ViewBag.TotalProducts sản phẩm
        </div>
        <ul class="pagination-list">
            <!-- Previous page button -->
            <li class="page-item-custom">
                <a class="page-link-custom @(currentPage == 1 ? "disabled" : "")" 
                   asp-action="Index" 
                   asp-route-page="@(currentPage - 1)"
                   asp-route-searchTerm="@ViewBag.SearchTerm">
                    <i class="fa-solid fa-angle-left"></i>
                </a>
            </li>

            <!-- Page numbers -->
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item-custom @(currentPage == i ? "active" : "")">
                    <a class="page-link-custom" 
                       asp-action="Index" 
                       asp-route-page="@i"
                       asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                </li>
            }

            <!-- Next page button -->
            <li class="page-item-custom">
                <a class="page-link-custom @(currentPage == totalPages ? "disabled" : "")" 
                   asp-action="Index" 
                   asp-route-page="@(currentPage + 1)"
                   asp-route-searchTerm="@ViewBag.SearchTerm">
                    <i class="fa-solid fa-angle-right"></i>
                </a>
            </li>
        </ul>
    </div>
}
