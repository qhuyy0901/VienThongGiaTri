@model AspNetMvcApp.Models.Product
@{
    ViewData["Title"] = "Thêm Sản Phẩm";
}

<style>
    .form-page-header {
        margin-bottom: 2rem;
    }

    .form-page-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.25rem;
    }

    .form-page-header p {
        color: var(--text-secondary);
        font-size: 0.88rem;
    }

    .form-card {
        background: var(--bg-dark-card);
        border: 1px solid var(--border-light);
        border-radius: 20px;
        padding: 2rem;
        max-width: 700px;
        backdrop-filter: var(--glass-blur);
    }

    .form-group {
        margin-bottom: 1.35rem;
    }

    .form-label {
        display: block;
        color: var(--text-secondary);
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 0.4rem;
    }

    .form-control-custom {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-light);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        color: var(--text-primary);
        font-size: 0.9rem;
        outline: none;
        transition: var(--transition-normal);
    }

    .form-control-custom:focus {
        border-color: rgba(59, 130, 246, 0.5);
        background: rgba(255, 255, 255, 0.06);
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.12);
    }

    .form-control-custom option {
        background: #0f1424;
        color: var(--text-primary);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .form-check-custom {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .form-check-custom input {
        accent-color: var(--accent-blue);
        width: 16px;
        height: 16px;
    }

    .form-check-custom label {
        color: var(--text-secondary);
        font-size: 0.88rem;
    }

    .form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border-light);
    }

    .btn-submit {
        background: var(--grad-primary);
        border: none;
        color: #fff;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        border-radius: 10px;
        cursor: pointer;
        transition: var(--transition-fast);
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    }

    .btn-cancel {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-light);
        color: var(--text-primary);
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        border-radius: 10px;
        cursor: pointer;
        transition: var(--transition-fast);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-cancel:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text-primary);
    }

    .validation-error {
        color: #ef4444;
        font-size: 0.78rem;
        margin-top: 0.3rem;
    }
</style>

<div class="form-page-header">
    <h1><i class="fa-solid fa-plus" style="color: var(--accent-emerald);"></i> Thêm Sản Phẩm Mới</h1>
    <p>Điền thông tin bên dưới để thêm sản phẩm vào cửa hàng.</p>
</div>

<div class="form-card">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label asp-for="Name" class="form-label">Tên Sản Phẩm</label>
            <input asp-for="Name" class="form-control-custom" placeholder="VD: iPhone 17 Pro Max" />
            <span asp-validation-for="Name" class="validation-error"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="CategoryId" class="form-label">Danh Mục</label>
                <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="form-control-custom">
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="CategoryId" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="form-label">Giá (USD)</label>
                <input asp-for="Price" class="form-control-custom" placeholder="VD: 1299.00" type="number" step="0.01" />
                <span asp-validation-for="Price" class="validation-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Rating" class="form-label">Đánh Giá (0 - 5)</label>
                <input asp-for="Rating" class="form-control-custom" placeholder="VD: 4.5" type="number" step="0.1" min="0" max="5" />
                <span asp-validation-for="Rating" class="validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="StockStatus" class="form-label">Trạng Thái Kho</label>
                <select asp-for="StockStatus" class="form-control-custom">
                    <option value="InStock">Còn hàng</option>
                    <option value="LowStock">Sắp hết hàng</option>
                    <option value="OutOfStock">Hết hàng</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Tải lên hình ảnh</label>
            <input type="file" id="uploadImages" name="uploadImages" multiple accept="image/*" class="form-control-custom" />
            <small style="color: var(--text-secondary); display: block; margin-top: 0.2rem;">Bạn có thể chọn nhiều ảnh. Sau đó chọn một ảnh làm đại diện chính bên dưới.</small>
        </div>

        <div id="imagePreviewContainer" class="form-row" style="margin-bottom: 1.35rem; display: none; background: rgba(255, 255, 255, 0.02); padding: 1rem; border-radius: 10px; border: 1px solid var(--border-light);">
            <!-- Image previews will be injected here -->
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">Mô Tả</label>
            <textarea asp-for="Description" class="form-control-custom" rows="4" placeholder="Nhập mô tả chi tiết sản phẩm..."></textarea>
            <span asp-validation-for="Description" class="validation-error"></span>
        </div>

        <div class="form-check-custom">
            <input asp-for="IsFeatured" type="checkbox" />
            <label asp-for="IsFeatured">Sản phẩm nổi bật</label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-plus"></i> Thêm Sản Phẩm
            </button>
            <a asp-action="Index" class="btn-cancel">
                <i class="fa-solid fa-xmark"></i> Hủy
            </a>
        </div>
    </form>
</div>

<script>
    document.getElementById('uploadImages').addEventListener('change', function(e) {
        const previewContainer = document.getElementById('imagePreviewContainer');
        previewContainer.innerHTML = '';
        previewContainer.style.display = 'grid';
        
        const files = e.target.files;
        if(files.length === 0) {
            previewContainer.style.display = 'none';
            return;
        }

        Array.from(files).forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const div = document.createElement('div');
                div.style.textAlign = 'center';
                div.style.background = 'rgba(0,0,0,0.2)';
                div.style.padding = '10px';
                div.style.borderRadius = '8px';
                
                const img = document.createElement('img');
                img.src = e.target.result;
                img.style.width = '100%';
                img.style.height = '120px';
                img.style.objectFit = 'contain';
                img.style.marginBottom = '10px';
                
                const radioContainer = document.createElement('div');
                radioContainer.className = 'form-check-custom';
                radioContainer.style.justifyContent = 'center';
                
                const radio = document.createElement('input');
                radio.type = 'radio';
                radio.name = 'mainImage';
                radio.value = file.name;
                radio.id = 'mainImage_' + index;
                if(index === 0) radio.checked = true; // Default select first
                
                const label = document.createElement('label');
                label.htmlFor = 'mainImage_' + index;
                label.innerText = 'Ảnh chính';
                
                radioContainer.appendChild(radio);
                radioContainer.appendChild(label);
                
                div.appendChild(img);
                div.appendChild(radioContainer);
                
                previewContainer.appendChild(div);
            }
            reader.readAsDataURL(file);
        });
    });
</script>
