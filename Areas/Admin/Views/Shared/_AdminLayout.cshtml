<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gia Trí Admin</title>
    
    <!-- Favicon link pointing to the corporate logo -->
    <link rel="icon" type="image/png" href="~/imager/logo.png" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Admin Layout Styles */
        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .admin-sidebar {
            width: 260px;
            background: var(--bg-dark-surface);
            border-right: 1px solid var(--border-light);
            padding: 1.5rem 0;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 50;
            backdrop-filter: var(--glass-blur);
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0 1.5rem 1.5rem;
            border-bottom: 1px solid var(--border-light);
            text-decoration: none;
            margin-bottom: 1.5rem;
        }

        .sidebar-brand-icon {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #0076f7, #00b4ff);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.15rem;
            box-shadow: 0 4px 15px rgba(0, 118, 247, 0.3);
        }

        .sidebar-brand-text {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--text-primary);
        }

        .sidebar-brand-badge {
            font-size: 0.65rem;
            font-weight: 600;
            background: rgba(0, 180, 255, 0.12);
            color: #00b4ff;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            border: 1px solid rgba(0, 180, 255, 0.2);
        }

        .sidebar-section-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0 1.5rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            padding: 0 0.75rem;
            flex: 1;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.7rem 0.85rem;
            border-radius: 10px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: var(--transition-fast);
            border: 1px solid transparent;
        }

        .sidebar-link:hover {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-primary);
        }

        .sidebar-link.active {
            background: rgba(59, 130, 246, 0.1);
            color: var(--text-primary);
            border-color: rgba(59, 130, 246, 0.2);
        }

        .sidebar-link.active i {
            color: var(--accent-blue);
        }

        .sidebar-link i {
            width: 20px;
            text-align: center;
            font-size: 1rem;
        }

        .sidebar-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid var(--border-light);
            margin-top: auto;
        }

        .sidebar-footer-link {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: var(--transition-fast);
            padding: 0.5rem 0;
        }

        .sidebar-footer-link:hover {
            color: var(--text-primary);
        }

        /* Main Content */
        .admin-main {
            margin-left: 260px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .admin-topbar {
            background: var(--bg-dark-surface);
            border-bottom: 1px solid var(--border-light);
            padding: 0.85rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 40;
            backdrop-filter: var(--glass-blur);
        }

        .topbar-title {
            font-family: 'Outfit', sans-serif;
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .admin-content {
            padding: 2rem;
            flex: 1;
            animation: contentFadeIn 0.4s ease;
        }

        .admin-footer {
            background: var(--bg-dark-surface);
            border-top: 1px solid var(--border-light);
            padding: 1rem 2rem;
            font-size: 0.8rem;
            color: var(--text-muted);
            text-align: center;
        }

        /* Toast notification */
        .toast-success {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.25);
            border-radius: 12px;
            padding: 0.85rem 1.25rem;
            color: var(--accent-emerald);
            font-size: 0.88rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            z-index: 9999;
            animation: slideInRight 0.35s ease, fadeOut 0.5s 3s forwards;
            backdrop-filter: var(--glass-blur);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        .toast-error {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.25);
            border-radius: 12px;
            padding: 0.85rem 1.25rem;
            color: #ef4444;
            font-size: 0.88rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            z-index: 9999;
            animation: slideInRight 0.35s ease, fadeOut 0.5s 3s forwards;
            backdrop-filter: var(--glass-blur);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        @@keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        @@keyframes fadeOut {
            to { opacity: 0; transform: translateY(-10px); }
        }
    </style>
</head>
<body class="theme-dark">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast-success">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <a href="/" class="sidebar-brand d-flex align-items-center gap-2" style="text-decoration: none;">
                <img src="~/imager/logo.png" alt="Gia Trí Logo" style="height: 38px; width: auto; object-fit: contain; border-radius: 4px;" asp-append-version="true" />
                <div>
                    <div class="sidebar-brand-text" style="font-size: 1.05rem; font-weight: 700;">Gia Trí</div>
                    <span class="sidebar-brand-badge">ADMIN</span>
                </div>
            </a>

            <div class="sidebar-section-label">Tổng Quan</div>
            <nav class="sidebar-nav">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="fa-solid fa-gauge-high"></i>
                    Dashboard
                </a>

                <div class="sidebar-section-label" style="padding: 0; margin-top: 1rem;">Quản Lý</div>

                <a asp-area="Admin" asp-controller="ProductManagement" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProductManagement" ? "active" : "")">
                    <i class="fa-solid fa-box-open"></i>
                    Sản Phẩm
                </a>

                <a asp-area="Admin" asp-controller="CategoryManagement" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CategoryManagement" ? "active" : "")">
                    <i class="fa-solid fa-folder-open"></i>
                    Danh Mục
                </a>

                <a asp-area="Admin" asp-controller="OrderManagement" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "OrderManagement" ? "active" : "")">
                    <i class="fa-solid fa-receipt"></i>
                    Đơn hàng
                </a>

                <a asp-area="Admin" asp-controller="AccountManagement" asp-action="Index"
                   class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AccountManagement" ? "active" : "")">
                    <i class="fa-solid fa-users-gear"></i>
                    Tài Khoản
                </a>
            </nav>

            <div class="sidebar-footer">
                <a asp-area="" asp-controller="Products" asp-action="Index" class="sidebar-footer-link">
                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại Cửa hàng
                </a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
                    <button type="submit" class="sidebar-footer-link" style="background: none; border: none; cursor: pointer; width: 100%; text-align: left; padding: 0.5rem 0; color: var(--text-secondary); font-size: 0.85rem; font-weight: 500;">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Đăng Xuất
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="admin-main">
            <header class="admin-topbar">
                <div class="topbar-title">
                    <i class="fa-solid fa-shield-halved" style="color: var(--accent-purple);"></i>
                    Admin Panel
                </div>
                <div class="topbar-actions">
                    <button id="themeToggleBtn" class="btn-theme-toggle" title="Chuyển chế độ sáng/tối">
                        <i class="fa-regular fa-moon theme-icon-dark"></i>
                        <i class="fa-regular fa-sun theme-icon-light" style="display: none;"></i>
                    </button>
                    <div class="user-avatar-wrapper" style="width: 32px; height: 32px;">
                        <div class="avatar-glow"></div>
                        <span class="user-avatar-initials" style="font-size: 0.75rem;">@User.Identity?.Name?.Substring(0, 2).ToUpper()</span>
                    </div>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                &copy; 2026 - Gia Trí Admin Panel - Hệ Thống Quản Trị
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
